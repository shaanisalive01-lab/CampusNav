{
  "name": "CampusNav",
  "short_name": "CampusNav",
  "description": "Find your way around campus, track your timetable, events and clubs.",
  "start_url": "./index.html#/home",
  "scope": "./",
  "display": "standalone",
  "orientation": "portrait",
  "background_color": "#f4f5f7",
